# Default Docker Compose port binds to localhost only.
DATABASE_PATH=/data/pulseforge.db
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=10
HISTORY_RETENTION_DAYS=30
ALLOW_PRIVATE_TARGETS=false
# For an exposed installation, set a long random token and use a TLS reverse proxy.
# ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional: an HTTPS endpoint accepting JSON notifications.
# ALERT_WEBHOOK_URL=https://your-webhook-endpoint.example/hooks/...
